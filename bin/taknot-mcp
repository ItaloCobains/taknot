#!/usr/bin/env node
/**
 * taknot MCP (stdio) — launched by Cursor / Claude / other harnesses.
 * Optional: TAKNOT_VAULT=/absolute/path/to/vault
 */
import { pathToFileURL } from 'node:url';
import path from 'node:path';
import { fileURLToPath } from 'node:url';

const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..');
await import(pathToFileURL(path.join(root, 'src', 'mcp', 'server.mjs')).href);
