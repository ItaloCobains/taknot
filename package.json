{
  "name": "taknot",
  "productName": "taknot",
  "version": "0.0.12",
  "description": "A beautiful markdown notes app for the desktop (Electron).",
  "main": ".vite/build/main.js",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
